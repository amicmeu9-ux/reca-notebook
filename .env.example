# =========================================================
# Gemini API (Solo servidor / Vite middleware, NO exponer con VITE_)
# =========================================================
GEMINI_API_KEY=

# =========================================================
# Firebase (Opcional: si se deja vacío, la app funciona en modo local)
# =========================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional para Firestore Enterprise Edition (si no usas '(default)'):
VITE_FIREBASE_DATABASE_ID=

# =========================================================
# Servidor Público HTTPS + Firebase Admin + Stripe (Solo servidor)
# =========================================================
PUBLIC_APP_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
