rules_version = '2';

// ===============================================================
// PRODUCTION FIRESTORE SECURITY RULES — Reca / Notebook
// ===============================================================
//
// DEPLOYMENT SWITCH INSTRUCTIONS:
//   - Prototype / client-only mode:
//       firebase.json -> "firestore": { "rules": "firestore.rules" }
//       (Permits bounded client-side wallet/transaction mutations when no
//        backend service account or Stripe billing endpoint is configured.)
//
//   - Hardened production mode (THIS FILE):
//       Once FIREBASE_SERVICE_ACCOUNT_JSON and STRIPE_SECRET_KEY are enabled
//       on the backend (for Stripe Checkout/webhooks, server-verified daily
//       claims, cross-user referral bonuses, and atomic AI Spark billing),
//       switch firebase.json to:
//         "firestore": { "rules": "firestore.production.rules" }
//       and deploy with:
//         firebase deploy --only firestore:rules
//
// NOTE: Trusted server code using Firebase Admin SDK / backend REST with
// service account credentials bypasses Firestore Security Rules, so it
// can update wallet balances and append transaction ledger documents even
// though client writes to wallet fields and transactions are denied here.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // This security rules file assumes the following data structures
    // derived from src/types/notebook.ts, src/config/brand.ts, and
    // src/services/repository/notebookRepository.ts:
    //
    // Collection: users
    // Document ID: {userId} (must match request.auth.uid)
    // Fields:
    //   - uid: string (required, immutable, must equal userId & auth.uid)
    //   - sparkBalance: int (required, immutable on client update; must equal 100 on client create)
    //   - lastDailyClaimAt: string | null (required key, immutable on client update; null on client create)
    //   - referralCode: string (required, immutable, 3-32 chars, matches ^(NB|RC)-[A-Z0-9]*$)
    //   - referralCount: int (required, immutable on client update; 0 on client create)
    //   - createdAt: string (required, immutable, UTC ISO-8601 string)
    //   - updatedAt: string (required, UTC ISO-8601 string; only client-updatable profile metadata)
    //
    // Subcollection: users/{userId}/tasks
    // Document ID: {taskId}
    // Fields:
    //   - id: string (required, immutable, 1-128 chars, must equal taskId)
    //   - uid: string (required, immutable, must equal userId & auth.uid)
    //   - title: string (required, 1-500 chars)
    //   - category: string (required, enum: 'Estudios' | 'Casa' | 'Personal')
    //   - dueDate: string | null (required key; YYYY-MM-DD when non-null)
    //   - dueTime: string | null (required key; HH:mm when non-null)
    //   - isExam: bool (required)
    //   - completed: bool (required; false on create)
    //   - completedAt: string | null (required key; null when completed == false, UTC ISO-8601 string when completed == true)
    //   - source: string (required, immutable, enum: 'voice_quick' | 'brain_dump' | 'scanner' | 'manual')
    //   - notes: string | null (required key; 0-2000 chars when non-null)
    //   - createdAt: string (required, immutable, UTC ISO-8601 string)
    //
    // Subcollection: users/{userId}/transactions
    // Document ID: {txId} (client read-only; written exclusively by backend / Firebase Admin SDK)
    // Fields:
    //   - uid: string (required, must equal userId)
    //   - type: string (required, enum: 'welcome' | 'daily_claim' | 'referral' | 'pack_purchase' | 'brain_dump' | 'scanner' | 'refund')
    //   - amount: int (required)
    //   - label: string (required, 1-200 chars)
    //   - createdAt: string (required, UTC ISO-8601 string)
    //
    // Queries verified against FirestoreNotebookRepository:
    //   - users/{uid}/tasks: orderBy('createdAt', 'desc')
    //   - users/{uid}/transactions: orderBy('createdAt', 'desc'), limit(30)
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource path (for user-owned documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is owner based on existing document's uid field
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // Verify uid hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that immutable fields have not changed on update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate string length bounds
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate UTC ISO-8601 date-time string produced by Date.toISOString()
    function isValidIsoDateString(dateStr) {
      return dateStr is string &&
        dateStr.size() >= 20 &&
        dateStr.size() <= 35 &&
        dateStr.matches("^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,9})?Z$");
    }

    // Validate YYYY-MM-DD task dueDate format
    function isValidDueDate(dateStr) {
      return dateStr is string &&
        dateStr.size() == 10 &&
        dateStr.matches("^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$");
    }

    // Validate HH:mm (24h) task dueTime format
    function isValidDueTime(timeStr) {
      return timeStr is string &&
        timeStr.size() == 5 &&
        timeStr.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$");
    }

    // Validate generated referralCode format (RC-... or legacy NB-...)
    function isValidReferralCode(code) {
      return code is string &&
        code.size() >= 3 &&
        code.size() <= 32 &&
        code.matches("^(NB|RC)-[A-Z0-9]*$");
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidUser(userId) {
      let data = request.resource.data;
      return hasOnlyAllowedFields([
               'uid', 'sparkBalance', 'lastDailyClaimAt',
               'referralCode', 'referralCount', 'createdAt', 'updatedAt'
             ]) &&
             hasRequiredFields([
               'uid', 'sparkBalance', 'lastDailyClaimAt',
               'referralCode', 'referralCount', 'createdAt', 'updatedAt'
             ]) &&
             data.uid is string && data.uid == userId &&
             data.sparkBalance is int &&
             data.sparkBalance >= 0 && data.sparkBalance <= 1000000 &&
             (data.lastDailyClaimAt == null || isValidIsoDateString(data.lastDailyClaimAt)) &&
             isValidReferralCode(data.referralCode) &&
             data.referralCount is int &&
             data.referralCount >= 0 && data.referralCount <= 100000 &&
             isValidIsoDateString(data.createdAt) &&
             isValidIsoDateString(data.updatedAt);
    }

    function isValidUserUpdate(userId) {
      // Wallet and identity fields are strictly server-managed once created;
      // clients may only update non-wallet profile metadata (e.g., updatedAt).
      return isValidUser(userId) &&
             uidNotModified() &&
             areImmutableFieldsUnchanged([
               'uid',
               'sparkBalance',
               'lastDailyClaimAt',
               'referralCount',
               'referralCode',
               'createdAt'
             ]);
    }

    function isValidTask(userId, taskId) {
      let data = request.resource.data;
      return hasOnlyAllowedFields([
               'id', 'uid', 'title', 'category', 'dueDate', 'dueTime',
               'isExam', 'completed', 'completedAt', 'source', 'notes', 'createdAt'
             ]) &&
             hasRequiredFields([
               'id', 'uid', 'title', 'category', 'dueDate', 'dueTime',
               'isExam', 'completed', 'completedAt', 'source', 'notes', 'createdAt'
             ]) &&
             data.id is string && data.id == taskId &&
             data.id.size() >= 1 && data.id.size() <= 128 &&
             data.uid is string && data.uid == userId &&
             validStringLength('title', 1, 500) &&
             data.category in ['Estudios', 'Casa', 'Personal'] &&
             (data.dueDate == null || isValidDueDate(data.dueDate)) &&
             (data.dueTime == null || isValidDueTime(data.dueTime)) &&
             data.isExam is bool &&
             data.completed is bool &&
             (
               (data.completed == false && data.completedAt == null) ||
               (data.completed == true && isValidIsoDateString(data.completedAt))
             ) &&
             data.source in ['voice_quick', 'brain_dump', 'scanner', 'manual'] &&
             (data.notes == null || (data.notes is string && data.notes.size() <= 2000)) &&
             isValidIsoDateString(data.createdAt);
    }

    // ===============================================================
    // Default Deny & Collection Rules
    // ===============================================================

    // Deny all reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Strictly owner-only read to protect wallet/account metadata
      allow read: if isOwner(userId);

      // Initial profile bootstrap (100 sparks = BRAND_CONFIG.currency.initialBalance)
      allow create: if isOwner(userId) &&
                       uidUnchanged() &&
                       isValidUser(userId) &&
                       request.resource.data.sparkBalance == 100 &&
                       request.resource.data.lastDailyClaimAt == null &&
                       request.resource.data.referralCount == 0;

      // Wallet fields (sparkBalance, lastDailyClaimAt, referralCount, referralCode),
      // uid, and createdAt are immutable from the client; only non-wallet metadata
      // (updatedAt) may be updated by the owner.
      allow update: if isOwner(userId) &&
                       isDocOwner() &&
                       isValidUserUpdate(userId);

      // Prevent profile deletion (blocks infinite welcome-bonus farming)
      allow delete: if false;

      match /tasks/{taskId} {
        // Supports orderBy('createdAt', 'desc') scoped to the authenticated owner
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidTask(userId, taskId) &&
                         request.resource.data.completed == false;

        allow update: if isOwner(userId) &&
                         isDocOwner() &&
                         uidNotModified() &&
                         isValidTask(userId, taskId) &&
                         areImmutableFieldsUnchanged(['id', 'uid', 'source', 'createdAt']);

        allow delete: if isOwner(userId) && isDocOwner();
      }

      match /transactions/{txId} {
        // Supports orderBy('createdAt', 'desc'), limit(30) scoped to the authenticated owner
        allow read: if isOwner(userId);

        // Stripe payments, webhook credits, server-side cross-user referral bonuses,
        // and server billing are written exclusively by Firebase Admin / backend REST
        // using service account credentials (which bypass Security Rules).
        allow create, update, delete: if false;
      }
    }
  }
}
